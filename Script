local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local LocalPlayer = Players.LocalPlayer

local ESPEnabled = true
local ESPs = {}
local Highlights = {}


local notifications = {}

local function addKillNotification(killer, victim)
    local notif = {
        text = killer.Name .. " killed " .. victim.Name,
        time = tick()
    }
    table.insert(notifications, notif)
end

local function drawNotifications()
    local screenGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not screenGui then return end
    
    local notifFrame = screenGui:FindFirstChild("KillNotificationFrame")
    if not notifFrame then
        notifFrame = Instance.new("Frame")
        notifFrame.Name = "KillNotificationFrame"
        notifFrame.Parent = screenGui
        notifFrame.Size = UDim2.new(0, 300, 0, 150)
        notifFrame.Position = UDim2.new(1, -310, 1, -160)
        notifFrame.BackgroundTransparency = 0.5
        notifFrame.BackgroundColor3 = Color3.new(0, 0, 0)
        notifFrame.BorderSizePixel = 0
    end
    
    for _, child in pairs(notifFrame:GetChildren()) do
        if child:IsA("TextLabel") then
            child:Destroy()
        end
    end
    
    local yOffset = 0
    for i, notif in ipairs(notifications) do
        local age = tick() - notif.time
        if age < 10 then
            local label = Instance.new("TextLabel")
            label.Parent = notifFrame
            label.Size = UDim2.new(1, 0, 0, 25)
            label.Position = UDim2.new(0, 0, 0, yOffset)
            label.Text = "🔪 " .. notif.text
            label.TextColor3 = Color3.fromRGB(255, 50, 50)
            label.BackgroundTransparency = 1
            label.TextSize = 14
            label.Font = Enum.Font.SourceSansBold
            label.TextXAlignment = Enum.TextXAlignment.Right
            
            if age > 8 then
                local fade = 1 - ((age - 8) / 2)
                label.TextTransparency = fade
            end
            
            yOffset = yOffset + 28
        end
    end
    
    notifFrame.Visible = #notifications > 0
end

local function setupKillListener()
    local function onCharacterAdded(player)
        local character = player.Character
        if character then
            local humanoid = character:WaitForChild("Humanoid")
            humanoid.Died:Connect(function()
                local killer = humanoid:FindFirstChild("LastDamager")
                if killer and killer.Value then
                    if killer.Value ~= LocalPlayer then
                        addKillNotification(killer.Value, player)
                    end
                end
            end)
        end
    end
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            player.CharacterAdded:Connect(onCharacterAdded)
            if player.Character then
                onCharacterAdded(player)
            end
        end
    end
    
    Players.PlayerAdded:Connect(function(player)
        if player ~= LocalPlayer then
            player.CharacterAdded:Connect(onCharacterAdded)
        end
    end)
end


local function setupPrompt(prompt)
    prompt.HoldDuration = 0
end

for _, obj in pairs(workspace:GetDescendants()) do
    if obj:IsA("ProximityPrompt") then
        setupPrompt(obj)
    end
end

workspace.DescendantAdded:Connect(function(obj)
    if obj:IsA("ProximityPrompt") then
        setupPrompt(obj)
    end
end)


UserInputService.InputBegan:Connect(function(input, gameProcessed)

    if gameProcessed then
        return
    end

    if input.KeyCode == Enum.KeyCode.H then

        ESPEnabled = not ESPEnabled

        for _, esp in pairs(ESPs) do
            if esp then
                esp.Enabled = ESPEnabled
            end
        end

        for _, h in pairs(Highlights) do
            if h then
                h.Enabled = ESPEnabled
            end
        end
    end
end)


local function getInventory(player)

    local items = {}

    local backpack = player:FindFirstChild("Backpack")

    if backpack then
        for _, tool in pairs(backpack:GetChildren()) do
            if tool:IsA("Tool") then
                table.insert(items, tool.Name)
            end
        end
    end

    if player.Character then
        for _, tool in pairs(player.Character:GetChildren()) do
            if tool:IsA("Tool") then
                table.insert(items, "[EQUIPPED] "..tool.Name)
            end
        end
    end

    return table.concat(items, ", ")
end


local function getHealth(player)
    local character = player.Character
    if character then
        local humanoid = character:FindFirstChild("Humanoid")
        if humanoid then
            return math.floor(humanoid.Health)
        end
    end
    return 0
end


local function isBlackened(player)

    local value = player:FindFirstChild("Blackened")

    if value and value:IsA("ObjectValue") then
        return true
    end

    return false
end


local function createESP(player)

    if player == LocalPlayer then
        return
    end

    local function onCharacter(character)

        local head = character:WaitForChild("Head")

        -- REMOVE OLD
        if head:FindFirstChild("InventoryESP") then
            head.InventoryESP:Destroy()
        end

        if character:FindFirstChild("ESPHighlight") then
            character.ESPHighlight:Destroy()
        end


        local billboard = Instance.new("BillboardGui")

        billboard.Name = "InventoryESP"
        billboard.Parent = head

        billboard.Adornee = head
        billboard.AlwaysOnTop = true

        billboard.Size = UDim2.new(0, 200, 0, 50)
        billboard.StudsOffset = Vector3.new(0, 3, 0)

        billboard.MaxDistance = 100
        billboard.LightInfluence = 0

        local text = Instance.new("TextLabel")

        text.Parent = billboard
        text.Size = UDim2.new(1,0,1,0)

        text.BackgroundTransparency = 1

        text.TextScaled = false
        text.TextSize = 14

        text.Font = Enum.Font.SourceSansBold
        text.TextStrokeTransparency = 0

        ESPs[player] = billboard


        local highlight = Instance.new("Highlight")

        highlight.Name = "ESPHighlight"
        highlight.Parent = character

        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop

        highlight.FillTransparency = 0.5
        highlight.OutlineTransparency = 0

        Highlights[player] = highlight


        RunService.RenderStepped:Connect(function()

            if not player.Character then
                return
            end

            if not ESPs[player] then
                return
            end

            local inventory = getInventory(player)

            if inventory == "" then
                inventory = "Empty"
            end

            local status = "INNOCENT"

            -- BLACKENED = RED
            if isBlackened(player) then

                status = "BLACKENED"

                text.TextColor3 = Color3.fromRGB(255,0,0)

                highlight.FillColor = Color3.fromRGB(255,0,0)
                highlight.OutlineColor = Color3.fromRGB(255,0,0)

            else

                -- INNOCENT = BLUE
                text.TextColor3 = Color3.fromRGB(0,170,255)

                highlight.FillColor = Color3.fromRGB(0,170,255)
                highlight.OutlineColor = Color3.fromRGB(0,170,255)
            end

            local health = getHealth(player)

            text.Text =
                player.Name ..
                "\n"..health.." HP" ..
                "\n["..status.."]" ..
                "\n"..inventory

            billboard.Enabled = ESPEnabled
            highlight.Enabled = ESPEnabled
        end)
    end

    if player.Character then
        onCharacter(player.Character)
    end

    player.CharacterAdded:Connect(onCharacter)
end


RunService.RenderStepped:Connect(function()
    drawNotifications()
end)


for _, player in pairs(Players:GetPlayers()) do
    createESP(player)
end

Players.PlayerAdded:Connect(createESP)

setupKillListener()
